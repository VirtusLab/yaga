package example:books;

// Server world: exports incoming-handler so wasmtime can dispatch HTTP requests
// into our component. Also imports outgoing-handler (harmless — matches the
// wasm-demo-tapir reference world and future-proofs if books-service ever calls
// another service) and wasi:cli/environment because WasmEnvReader reads
// YAGA_WASM_SERVICE_CONFIG via `wasi:cli/environment@0.2.0`.
world scala {
  import wasi:cli/environment@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;
  import wasi:http/types@0.2.0;
  export wasi:http/incoming-handler@0.2.0;
}
