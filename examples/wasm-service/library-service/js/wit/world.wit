package example:library;

// library-service both *serves* HTTP (incoming-handler export) and *calls*
// books-service (outgoing-handler import). Both halves must be declared in
// the world or wasmtime will refuse to instantiate the component.
world scala {
  import wasi:cli/environment@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;
  import wasi:http/types@0.2.0;
  export wasi:http/incoming-handler@0.2.0;
}
